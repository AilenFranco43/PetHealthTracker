{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:dev",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full App",
      "configurations": [
        "Backend",
        "Frontend"
      ],
      "stopAll": true
    }
  ]
}